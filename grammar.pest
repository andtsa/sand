// language definition
WHITESPACE = _{ " " | "\t" | "\n" | "\r" }
COMMENT    = _{ ("/*" ~ (!"*/" ~ ANY)* ~ "*/") | ("//" ~ (!"\n" ~ ANY)*) }

// primitive tokens

// Qualified type: `mod::TypeName`
qualified_type = { identifier ~ "::" ~ identifier }

// Ad-hoc tag union type: `#ok | #err` (structural, anonymous)
tag_type = { "#" ~ identifier ~ ("|" ~ "#" ~ identifier)* }

// Tuple type: `(Int, Bool)`, arity >= 2 (one element is just grouping, handled by build_type)
tuple_type = { "(" ~ type_ ~ ("," ~ type_)+ ~ ")" }

// Generic enum instantiation at a use site: `Option<Int>`, `Either<Int, Bool>`,
// `Holder<'a>`, `Both<'a, Int>`. Region (lifetime) arguments come first, then
// type arguments (the lifetimes-first convention; enforced in `build_type`).
type_application = { identifier ~ "<" ~ type_app_arg ~ ("," ~ type_app_arg)* ~ ">" }
type_app_arg = { lifetime | type_ }

// a lifetime / region: `'r`, `'heap`, `'static`.
// atomic so no internal whitespace is consumed between the tick and the name.
lifetime = @{ "'" ~ identifier }

// primitive type keywords
prim_int  = @{ "Int" ~ !(ASCII_ALPHANUMERIC | "_") }
prim_bool = @{ "Bool" ~ !(ASCII_ALPHANUMERIC | "_") }
prim_unit = @{ "Unit" ~ !(ASCII_ALPHANUMERIC | "_") } // equivalent to rust (), python None

core_type = {
    prim_int
  | prim_bool
  | prim_unit

  | qualified_type // cross-module enum type: mod::TypeName

  | tag_type // ad-hoc tag union: #ok | #err

  | tuple_type // product type: (A, B, ...)

  | type_application // generic instantiation: Option<Int>

  | borrow_type // shared reference: &T, &'r T

  | identifier // named enum type
}

// reference type `&'r T` (shared) or `&'r mut T` (exclusive)
borrow_type = { "&" ~ lifetime? ~ mut_kw? ~ core_type }

// a function arrow, optionally annotated with the calling mode
arrow_kind = { "Owned" | "BorrowedMut" | "Borrowed" }
fn_arrow   = { ("-[" ~ arrow_kind ~ "]>") | "->" }

// a function type `A -> B`. Unary and right-associative
// (`A -> B -> C` is `A -> (B -> C)`); the codomain is a full `type_` so it may
// itself be a function type. The domain is a `core_type`: a nested arrow in the
// domain (`(A -> B) -> C`) needs the parenthesised form
fn_type = { core_type ~ fn_arrow ~ type_ }

// a type, optionally ascribed to a region: `Int`, `Int @ 'r`
// the `@ 'r` suffix is parsed here (rather than a left-recursive `region_type`)
// so the grammar stays a valid PEG.
// A function type is tried first (it needs the `->`), falling back to an ascribed core type.
type_ = { fn_type | core_type ~ ("@" ~ lifetime)? }

// keywords (prevent them from being identifiers)
KEYWORD = { "if" | "then" | "else" | "let" | "def" | "true" | "false" | "Unit" | "Int" | "Bool" | "while" | "do" | "module" | "mut" | "type" | "match" | "and" | "or" | "xor" | "where" | "use" | "typeclass" | "impl" | "requires" | "for" | "extern" | "deriving" | "fn" }

identifier       = @{ !(KEYWORD ~ !(ASCII_ALPHANUMERIC | "_")) ~ "_"* ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
empty_identifier = @{ "_" }

number = @{ ASCII_DIGIT+ }

boolean = @{ "true" | "false" }

unary_operand = { subtract | negate }

add      = { "+" }
subtract = { "-" }
multiply = { "*" }
divide   = { "/" }
pow      = { "^" }
negate   = { "!" }
bitand   = { "&&" }
logand   = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") }
or       = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") }
xor      = @{ "⊕" | ("xor" ~ !(ASCII_ALPHANUMERIC | "_")) }
gt       = { ">" }
lt       = { "<" }
ne       = { "≠" | "!=" }
eq       = { "==" }
ge       = { ">=" | "≥" }
le       = { "<=" | "≤" }

// type parameters on a generic declaration: `<T>`, `<+a : Owned, -b>`.
// each parameter carries an optional variance annotation
// (`+`/`-`; absent = // default)
// and an optional kind annotation (absent = `Owned`).
// a kind is a base kind (`Owned`/`Never`)
// or a type-constructor arrow `Owned -> Owned`
// `->` is right-associative and may be parenthesised
// (`(Owned -> Owned) -> Owned`). only appears in declaration position (right
// after the def/type name); uses of a type parameter inside a type are bare
// identifiers (applied via `F<A>`).
variance_ann = { "+" | "-" }
kind_atom    = { "Owned" | "Never" | "(" ~ kind_ann ~ ")" }
kind_ann     = { kind_atom ~ ("->" ~ kind_atom)* }
type_param   = { variance_ann? ~ identifier ~ (":" ~ kind_ann)? }
// a region (lifetime) parameter `'r` declared on a generic item
region_param = { lifetime }
type_params  = { "<" ~ (region_param | type_param) ~ ("," ~ (region_param | type_param))* ~ ">" }

where_constraint = { (lifetime ~ ">=" ~ lifetime) | (identifier ~ ":" ~ identifier) }
where_clause     = { "where" ~ where_constraint ~ ("," ~ where_constraint)* }

// enum type declarations
// a variant is a bare tag (`Red`, nullary) or a tag with a payload (`Ok(Int)`).
// Multiple comma-separated payload types are sugar for a single tuple payload:
// `Cons(Int, List)` ≡ `Cons((Int, List))`.
enum_variant = { identifier ~ ("(" ~ type_ ~ ("," ~ type_)* ~ ")")? }
// `deriving C1, C2, ...` — request compiler-derived instances (Memory Step C).
// A general mechanism; in Step C only `HeapedUnique` is a registered derivable.
deriving_clause = { "deriving" ~ identifier ~ ("," ~ identifier)* }
type_alias   = { "type" ~ identifier ~ type_params? ~ "=" ~ enum_variant ~ ("|" ~ enum_variant)* ~ deriving_clause? ~ ";"? }

// A comma-separated payload list is sugar for a single tuple payload:
// `Result#Ok(a, b)` ≡ `Result#Ok((a, b))`.
external_constructor_expr = { identifier ~ "::" ~ identifier ~ "#" ~ identifier ~ ("(" ~ expression ~ ("," ~ expression)* ~ ")")? }
constructor_expr          = { identifier ~ "#" ~ identifier ~ ("(" ~ expression ~ ("," ~ expression)* ~ ")")? }
tag_expr                  = { "#" ~ identifier ~ ("(" ~ expression ~ ("," ~ expression)* ~ ")")? }

// pattern matching
// patterns are recursive: a payload-carrying variant or a tuple may itself
// contain (irrefutable) sub-patterns that bind/destructure the payload.
wildcard_pattern    = { "_" }
binding_pattern     = { identifier }
tuple_pattern       = { "(" ~ pattern ~ ("," ~ pattern)+ ~ ")" }
// A comma-separated sub-pattern list is sugar for a single tuple sub-pattern:
// `Cons(x, rest)` ≡ `Cons((x, rest))`.
tag_pattern         = { "#" ~ identifier ~ ("(" ~ pattern ~ ("," ~ pattern)* ~ ")")? }
constructor_pattern = { identifier ~ "#" ~ identifier ~ ("(" ~ pattern ~ ("," ~ pattern)* ~ ")")? }
// literal patterns (refutable; int/bool values in match position)
// bool_literal_pattern must precede binding_pattern so "true"/"false" are
// not captured as variable names (they are keywords, but the ordering makes
// the intent explicit). int_literal_pattern supports optional leading minus.
int_literal_pattern  = @{ "-"? ~ number }
bool_literal_pattern = @{ "true" | "false" }
pattern              =  { constructor_pattern | tag_pattern | tuple_pattern | wildcard_pattern | bool_literal_pattern | int_literal_pattern | binding_pattern }
match_arm            =  { pattern ~ "=>" ~ expression ~ ","? }
match_expr           =  { "match" ~ expression ~ "{" ~ match_arm+ ~ "}" }

// the language is built around expressions

ifstatement = { "if" ~ expression ~ "then" ~ expression ~ ("else" ~ expression)? }

whileloop = { "while" ~ expression ~ "do" ~ expression }

// Monadic bind for do-notation. Any block `{ ... }` that contains a top-level
// `<-` is treated as a do-block: `build_ast::build_block` desugars it to nested
// `bind(e, fn (x: T) -> ...)` calls (each `<-` is a bind, ordinary
// `let`/statements between binds stay pure, and the trailing expression is the
// block's monadic result, type `F<_>`).
monadic_bind = { identifier ~ ":" ~ type_ ~ "<-" ~ expression ~ ";" }

// `f::<T, ...>(args)`
turbofish              = { "::" ~ "<" ~ type_ ~ ("," ~ type_)* ~ ">" }
function_call          = { identifier ~ turbofish? ~ "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }
external_function_call = { identifier ~ "::" ~ identifier ~ "(" ~ (expression ~ ("," ~ expression)*)? ~ ")" }

// tuple literal: `(a, b, ...)`
tuple_expr = { "(" ~ expression ~ ("," ~ expression)+ ~ ")" }

// lambda expression `fn (x: T) -> e`
// the body is a full `expression`, so it extends as far right as possible
// (`fn (x: Int) -> x + 1` has body `x + 1`);
// a terminator (`,`, `)`, `}`, ...) ends it.
lambda_param = { "(" ~ mut_kw? ~ identifier ~ ":" ~ type_ ~ ")" }
lambda_expr  = { "fn" ~ lambda_param ~ fn_arrow ~ expression }

// precedence chaining

// borrow expression `&e` (shared) or `&mut e` (exclusive)
// binds tightly (to a primary), so `&x + 1` is `(&x) + 1`.
borrow_expr = { "&" ~ mut_kw? ~ primary }

// dereference expression `*e`: read through a reference (`&T`/`&mut T` -> T).
// like `borrow_expr` it binds to a primary, so `*x + 1` is `(*x) + 1`. the
// prefix `*` is unambiguous with the infix multiply, which only appears
// between operands.
deref_expr = { "*" ~ primary }

primary = {
    borrow_expr
  | deref_expr
  | tuple_expr
  | ("(" ~ expression ~ ")")
  | ifstatement
  | whileloop
  | match_expr
  | function_call
  | external_function_call
  | external_constructor_expr
  | constructor_expr
  | tag_expr
  | number
  | boolean
  | identifier
  | ("{" ~ (monadic_bind | statement)* ~ expression? ~ "}")
}

unary      = { (unary_operand ~ unary) | primary }
power      = { unary ~ (pow ~ power)? }
mul_div    = { power ~ ((multiply | divide) ~ power)* }
add_sub    = { mul_div ~ ((add | subtract) ~ mul_div)* }
comparison = { add_sub ~ ((ge | le | gt | lt) ~ add_sub)* }
equality   = { comparison ~ ((eq | ne) ~ comparison)* }
logic_and  = { equality ~ ((logand | bitand) ~ equality)* }
logic_xor  = { logic_and ~ (xor ~ logic_and)* }
logic_or   = { logic_xor ~ (or ~ logic_xor)* }
// a lambda binds looser than any operator (its body is a full expression), so it
// sits at the top of the expression grammar.
expression = { lambda_expr | logic_or }

mut_kw = { "mut" }

// tuple-pattern `let` binding: `let (a, mut b) = expr`
let_tuple_elem = { mut_kw? ~ identifier }
let_tuple      = { "(" ~ let_tuple_elem ~ ("," ~ let_tuple_elem)+ ~ ")" }

// constructor-pattern `let` binding: `let E#V(payload) = expr else fallback`
// Sub-pattern elements are immutable bindings only (no mut_kw at this level), for now.
// Mutability in top-level let-tuple bindings (`let (a, mut b) = ...`) is unaffected.
let_binding_elem  = { identifier | empty_identifier }
let_binding_tuple = { "(" ~ let_binding_elem ~ ("," ~ let_binding_elem)+ ~ ")" }
let_destructure   = { let_constructor | let_binding_tuple | let_binding_elem }
let_constructor   = { identifier ~ "#" ~ identifier ~ ("(" ~ let_destructure ~ ")")? }

// borrow binding `let &x = e` (shared) or `let &mut x = e` (exclusive)
borrow_binding = { "&" ~ mut_kw? ~ (identifier | empty_identifier) }

// variables, either a single binding, a flat tuple-pattern, a constructor-pattern, or bare binding
// The `else` clause is required when the LHS is a refutable (constructor) pattern.
declaration = {
    "let" ~ (let_constructor | let_tuple | borrow_binding | mut_kw? ~ (identifier | empty_identifier)) ~ (":" ~ type_)? ~ "=" ~ expression ~ ("else" ~ expression)?
}

// `x = e` (reseat / variable write) or `*r = e` (write-through a `&mut`). The
// `=` disambiguates from a bare `*r` expression statement.
assignment = { (deref_expr | identifier) ~ "=" ~ expression }

// statements are the imperative elements of the language
statement = { ((declaration | assignment | expression) ~ ";") }

// functions are highest-order tokens
parameter  = { mut_kw? ~ (identifier | empty_identifier) ~ ":" ~ type_ }
parameters = { parameter ~ ("," ~ parameter)* ~ ","? }

function = { "def" ~ identifier ~ type_params? ~ "(" ~ parameters? ~ ")" ~ ":" ~ type_ ~ where_clause? ~ ":=" ~ expression }

// External (FFI) function declaration:
// a bodyless `def` bound to a C symbol of the same name.
extern_decl = { "extern" ~ "def" ~ identifier ~ "(" ~ parameters? ~ ")" ~ ":" ~ type_ ~ ";" }

// typeclass declaration
typeclass_method = { "def" ~ identifier ~ type_params? ~ "(" ~ parameters? ~ ")" ~ ":" ~ type_ ~ where_clause? ~ (":=" ~ expression)? }
requires_clause  = { "requires" ~ identifier ~ ("," ~ identifier)* }
typeclass_decl   = { "typeclass" ~ identifier ~ type_params ~ requires_clause? ~ "{" ~ typeclass_method* ~ "}" }

// typeclass implementation: `impl Eq for Int { def eq(...) := ... }`.
impl_decl = { "impl" ~ identifier ~ "for" ~ type_ ~ "{" ~ function* ~ "}" }

module = { "module" ~ identifier ~ ";"? }

// import a name (or all names) from another module into unqualified scope
use_glob = { "*" }
use_path = { identifier ~ ("::" ~ identifier)* ~ ("::" ~ use_glob)? }
use_decl = { "use" ~ use_path ~ ";" }

program = { SOI ~ (function | extern_decl | type_alias | typeclass_decl | impl_decl | module | use_decl)* ~ EOI }
