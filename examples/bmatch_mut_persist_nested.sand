//@TEST:{120}[]

// Stress: a *nested* `&mut` borrowing match (Wrap -> Pair) writes through two
// levels of interior `&mut` field projection, and the mutation must persist to
// the original `w` (read back afterwards by value).

type Pair = P(Int, Int)
type Wrap = W(Pair)

def main(): Int := {
    let mut w = Wrap#W(Pair#P(1, 2));
    {
        match &mut w {
            Wrap#W(p) => match p { Pair#P(a, b) => { *a = 10; *b = 20; } }
        };
    };
    match w { Wrap#W(p) => match p { Pair#P(a, b) => a * 10 + b } }
}
