//@TEST: run
// exit: 0
// stdout: [1, 3, 0, 42]


type Wrapper = Val(Result<Int, Int>) | Empty;

def classify(w: Wrapper): Int :=
    match w {
        Wrapper#Val(Result#Ok(n)) => n,
        Wrapper#Val(_)            => -1,
        Wrapper#Empty             => -2,
    }

def wrapper_ok(w: Wrapper): Int :=
    match w {
        Wrapper#Val(Result#Ok(_)) => 1,
        _                         => 0,
    }

def main(): Int := {
    println(wrapper_ok(Wrapper#Val(Result#Ok(99))));   // 1
    println(classify(Wrapper#Val(Result#Ok(3))));      // 3
    println(wrapper_ok(Wrapper#Val(Result#Err(5))));   // 0
    println(classify(Wrapper#Val(Result#Ok(42))));     // 42
    0
}
