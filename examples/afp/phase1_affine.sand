//@TEST: run
// exit: 2

// phase 1 affine types: every (non-`Copy`) value is used at most once.
// Using a value *moves* it; using it again is a static error.

type Light = Red | Yellow | Green

def rank(l: Light): Int := match l {
    Light#Red => 1,
    Light#Yellow => 2,
    Light#Green => 3,
}

def main(): Int := {
    // `rank` *consumes* `light`. A second `rank(light)` here would be:
    //   error: use of moved value `light`
    let light = Light#Red;
    let r1 = rank(light);

    // re-binding `light` gives it a fresh value, usable again
    let light = Light#Yellow;
    let r2 = rank(light);

    // transferring ownership `a` -> `b`: `a` is moved, `b` now owns the value.
    // `rank(a)` after the move would error; `rank(b)` is fine.
    let a = Light#Green;
    let b = a;
    let r3 = rank(b);

    r1 + r3 - r2          // 1 + 3 - 2 = 2
}
