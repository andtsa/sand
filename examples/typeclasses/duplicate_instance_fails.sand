type Duo<A, B> = Two(A, B)

impl Functor for Duo<_, Int> {
    def fmap<A, B>(x: Duo<A, Int>, f: A -> B): Duo<B, Int> := match x { Duo#Two(a, e) => Duo#Two(f(a), e) }
}
