//@TEST:{0}[40,-1]

type Option<a> = None | Some(a)

impl Functor for Option {
    def fmap<A, B>(x: Option<A>, f: A -> B): Option<B> := match x {
        Option#None => Option#None,
        Option#Some(v) => Option#Some(f(v)),
    }
}
impl Applicative for Option {
    def pure<A>(x: A): Option<A> := Option#Some(x)
    def ap<A, B>(f: Option<A -> B>, x: Option<A>): Option<B> := match f {
        Option#None => Option#None,
        Option#Some(g) => match x {
            Option#None => Option#None,
            Option#Some(v) => Option#Some(g(v)),
        },
    }
}
impl Monad for Option {
    def bind<A, B>(x: Option<A>, f: A -> Option<B>): Option<B> := match x {
        Option#None => Option#None,
        Option#Some(v) => f(v),
    }
}

def safe_div(a: Int, b: Int): Option<Int> := if b == 0 then Option#None else Option#Some(a / b)
def or_else(x: Option<Int>, fallback: Int): Int := match x {
    Option#Some(v) => v,
    Option#None => fallback,
}

// A monadic block: any `<-` short-circuits on `None` without explicit matching.
def compute(divisor: Int): Option<Int> := {
    x: Int <- safe_div(100, 5);     // 20
    let doubled = x * 2;            // ordinary pure let, stays a let
    y: Int <- safe_div(doubled, divisor);
    Option#Some(x + y)
}

def main(): Int := {
    println(or_else(compute(2), -1));    // 20 + (40/2)=20 -> 40
    println(or_else(compute(0), -1));    // divide-by-zero short-circuits -> -1
    0
}
