// stage: typecheck
// message: includes "not yet supported"

// Failing case (load-bearing soundness guard): destructuring a `deriving Heaped`
// type through a reference is rejected. A `&List` references a `Unique` handle;
// reading its fields needs a `unique_borrow` indirection that does not exist, and
// without the guard a realloc/free through the scrutinee could dangle a field
// borrow.

type List = Nil | Cons(Int, List) deriving Heaped

def head_or(l: &List): Int := match l { List#Nil => 0, List#Cons(h, t) => *h }

def main(): Int := 0
