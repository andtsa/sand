//@TEST: fail
// stage: ownership
// message: includes "cannot move a non-`Copy` value out of a borrow"

// Failing case: a borrowing match binds `b : &Box` (a borrow of the field).
// `*b` would move the non-`Copy` `Box` out of that borrow, which must be
// rejected (`MoveOutOfBorrow`). Compare: `*n` of an `Int` field is fine (Copy).

type Box = B(Int)
type Wrap = W(Box)

def f(w: &Wrap): Box := match w { Wrap#W(b) => *b }

def main(): Int := 0
