//@TEST:{0}[42,7,42,22,43]
// Step 13 — the Functor / Applicative / Monad hierarchy from `core.sand`,
// instantiated for `Option`. Exercises higher-kinded instances (Step 11) whose
// methods take and return lambdas (Step 13), plus return-type-driven dispatch
// for `pure` (which has no `F<_>` argument to resolve its instance from).

type Option<a> = None | Some(a)

impl Functor for Option {
    def fmap<A, B>(x: Option<A>, f: A -> B): Option<B> := match x {
        Option#None => Option#None,
        Option#Some(v) => Option#Some(f(v)),
    }
}

impl Applicative for Option {
    def pure<A>(x: A): Option<A> := Option#Some(x)
    def ap<A, B>(f: Option<A -> B>, x: Option<A>): Option<B> := match f {
        Option#None => Option#None,
        Option#Some(g) => match x {
            Option#None => Option#None,
            Option#Some(v) => Option#Some(g(v)),
        },
    }
}

impl Monad for Option {
    def bind<A, B>(x: Option<A>, f: A -> Option<B>): Option<B> := match x {
        Option#None => Option#None,
        Option#Some(v) => f(v),
    }
}

def or_else(x: Option<Int>, fallback: Int): Int := match x {
    Option#None => fallback,
    Option#Some(v) => v,
}

def main(): Int := {
    // fmap over a present value, and over an absent one (short-circuits).
    println(or_else(fmap(Option#Some(21), fn (n: Int) -> n * 2), 0));   // 42
    let none: Option<Int> = Option#None;
    println(or_else(fmap(none, fn (n: Int) -> n * 2), 7));              // 7

    // pure: the instance is recovered from the annotated expected type.
    let lifted: Option<Int> = pure(42);
    println(or_else(lifted, 0));                                        // 42

    // ap: apply a wrapped function to a wrapped argument.
    let wrapped: Option<Int -> Int> = Option#Some(fn (n: Int) -> n + 1);
    println(or_else(ap(wrapped, Option#Some(21)), 0));                  // 22

    // bind: chain a computation that itself returns an Option.
    println(or_else(bind(Option#Some(21), fn (n: Int) -> Option#Some(n + 22)), 0)); // 43
    0
}
