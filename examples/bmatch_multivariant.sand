//@TEST:{34}[]

// Stress: a borrowing match over an enum with variants of *different* payload
// shapes (single payload, tuple payload, nullary). Exercises the variant-payload
// occurrence (`&payload`) and the tuple-element occurrences together, dispatched
// through the decision tree.

type E = A(Int) | B(Int, Int) | C

def eval(e: &E): Int := match e {
    E#A(x) => *x,
    E#B(y, z) => *y * 10 + *z,
    E#C => 0,
}

def main(): Int := eval(&E#B(3, 4))
