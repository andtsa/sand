def abs(n: Int): Int := __abs(n)

def min(a: Int, b: Int): Int := __min(a, b)

def max(a: Int, b: Int): Int := __max(a, b)

def clamp(n: Int, lo: Int, hi: Int): Int := min(max(n, lo), hi)

def is_odd(n: Int): Bool := (n && 1) != 0

def is_even(n: Int): Bool := (n && 1) == 0

def pow(base: Int, exp: Int): Int :=
    if base == 0 then 0
    else if base == 1 then 1
    else if exp < 0 then 0
    else if exp == 0 then 1
    else if exp == 1 then base
    else if is_even(exp) then pow(base, exp / 2) * pow(base, exp / 2)
    else base * pow(base, exp - 1)

def read_int(): Int := __read_int()

def exit(code: Int): Unit := __exit(code)

// ============= Ownership model ==================

// Types that implement `Clone` can use
// `clone(x : &T) -> T` to receive a duplicate of the borrowed value `x`.
// `clone` returns a fresh owned value; for primitives that is just a dereference,
// for other types it may be a deep copy.
typeclass Clone<T> { def clone(x: &T): T }

// Implementing `Copy` on a type signals to the compiler
// that values of that type can be copied/cloned implicitly.
typeclass Copy<T> requires Clone { }

impl Clone for Int { def clone(x: &Int): Int := *x }
impl Copy for Int { }

impl Clone for Bool { def clone(x: &Bool): Bool := *x }
impl Copy for Bool { }

impl Clone for Unit { def clone(x: &Unit): Unit := *x }
impl Copy for Unit { }


// ============= Concurrency ==================

// Marker typeclasses for thread safety 
//
// `Send<T>`: a value of `T` may be moved to another thread.
// `Sync<T>`: `&T` may be shared with another thread (i.e. `&T : Send`).
//
// The builtin structural rules are: primitives are `Send + Sync`; a shared
// `&T` is `Send`/`Sync` iff `T : Sync`; a `&mut T` is `Send` iff `T : Send` and
// `Sync` iff `T : Sync`; a tuple iff every element is; raw `Ptr<T>` is neither.
// Aggregate types opt in with an empty `impl Send for E { }` (and `Sync`).
typeclass Send<T> { }
typeclass Sync<T> { }

// A handle to a computation running (conceptually) on another thread, yielding
// an `R` when joined.
//
// NOTE: the current implementation runs `spawn`'s work *synchronously*: `spawn(f, x)`
// evaluates `f(x)` eagerly and stores the result, and `join` returns it. The
// `Send` bounds are the enforced safety obligation; swapping in OS threads
// (a `__spawn` intrinsic + a pthread runtime) is a backwards-compatible follow-up
// that only changes `spawn`/`join`'s bodies and `Thread`'s representation.
type Thread<R> = Th(R)

// Run `task(arg)` on another thread. Both the moved-in argument and the
// produced result must be `Send`.
//
// NOTE: `spawn` *calls* its higher-order parameter `task`, and call syntax
// prefers a global function of the same name, so a
// program that defines a top-level `def task` shadows this and fails to compile.
// This is inherent to the current call-resolution design (it affects any
// higher-order function, e.g. `apply`); the planned `__spawn` intrinsic removes
// it for `spawn` specifically.
def spawn<T, R>(task: T -> R, arg: T): Thread<R> where T : Send, R : Send :=
    Thread#Th(task(arg))

// Wait for a spawned computation and take its result.
def join<R>(t: Thread<R>): R := match t {
    Thread#Th(r) => r
}


// ================ Monad heirarchy ==================

// A `Functor` lets you map a function over the contents of an `F<A>`.
typeclass Functor<F : Owned -> Owned> {
    def fmap<A, B>(x: F<A>, f: A -> B): F<B>
}

// An `Applicative` can lift a plain value into `F` (`pure`) and apply a wrapped
// function to a wrapped argument (`ap`). `pure`'s instance is recovered from the
// expected type at the call site (it has no `F<_>` argument to dispatch on).
typeclass Applicative<F : Owned -> Owned> requires Functor {
    def pure<A>(x: A): F<A>
    def ap<A, B>(f: F<A -> B>, x: F<A>): F<B>
}

// A `Monad` sequences computations: `bind` feeds the contents of an `F<A>` into
// a function producing the next `F<B>`.
typeclass Monad<F : Owned -> Owned> requires Applicative {
    def bind<A, B>(x: F<A>, f: A -> F<B>): F<B>
}


// ============= Useful builtins ================

// `Option<T>`: a value that may be absent — `Some(x)` or `None`. The canonical
// alternative to a sentinel value for "might not be there".
type Option<T> = None | Some(T)

// `Option` is a lawful `Functor`/`Applicative`/`Monad`: it has exactly one type
// argument, so it matches the `Owned -> Owned` kind those classes require.
impl Functor for Option {
    def fmap<A, B>(x: Option<A>, f: A -> B): Option<B> := match x {
        Option#None => Option#None,
        Option#Some(v) => Option#Some(f(v)),
    }
}

impl Applicative for Option {
    def pure<A>(x: A): Option<A> := Option#Some(x)
    def ap<A, B>(f: Option<A -> B>, x: Option<A>): Option<B> := match f {
        Option#None => Option#None,
        Option#Some(g) => match x {
            Option#None => Option#None,
            Option#Some(v) => Option#Some(g(v)),
        },
    }
}

impl Monad for Option {
    def bind<A, B>(x: Option<A>, f: A -> Option<B>): Option<B> := match x {
        Option#None => Option#None,
        Option#Some(v) => f(v),
    }
}

// Inspect presence without consuming (borrows the option).
def is_some<T>(o: &Option<T>): Bool := match o {
    Option#Some(_) => true,
    Option#None => false,
}

def is_none<T>(o: &Option<T>): Bool := match o {
    Option#None => true,
    Option#Some(_) => false,
}

// Take the contained value, falling back to `default` when absent. Consumes the
// option (and drops `default` when it is unused).
def get_or<T>(o: Option<T>, default: T): T := match o {
    Option#Some(v) => v,
    Option#None => default,
}

// Collapse one layer of nesting: `Some(Some(x)) -> Some(x)`, else `None`.
def flatten<T>(o: Option<Option<T>>): Option<T> := match o {
    Option#Some(inner) => inner,
    Option#None => Option#None,
}


// `Result<T, E>`: a computation that either succeeds with `Ok(T)` or fails with
// `Err(E)`. Threads an error value through code instead of diverging.
//
// `Result` is *binary*, but it still joins the `Functor`/`Applicative`/`Monad`
// hierarchy via **partial application** (Calculus §4.5): fixing the error type
// `E` leaves the unary constructor `Result<_, E>` those classes require. The
// instances operate on the success channel; the error rides along unchanged.
// (`map_err` and `ok` below have no instance form — they act on the *error*
// channel / project into `Option` — so they remain as helpers.)
type Result<T, E> = Ok(T) | Err(E)

impl<E> Functor for Result<_, E> {
    def fmap<A, B>(x: Result<A, E>, f: A -> B): Result<B, E> := match x {
        Result#Ok(v) => Result#Ok(f(v)),
        Result#Err(e) => Result#Err(e),
    }
}

impl<E> Applicative for Result<_, E> {
    def pure<A>(x: A): Result<A, E> := Result#Ok(x)
    def ap<A, B>(f: Result<A -> B, E>, x: Result<A, E>): Result<B, E> := match f {
        Result#Ok(g) => match x {
            Result#Ok(v) => Result#Ok(g(v)),
            Result#Err(e) => Result#Err(e),
        },
        Result#Err(e) => Result#Err(e),
    }
}

impl<E> Monad for Result<_, E> {
    def bind<A, B>(x: Result<A, E>, f: A -> Result<B, E>): Result<B, E> := match x {
        Result#Ok(v) => f(v),
        Result#Err(e) => Result#Err(e),
    }
}

def is_ok<T, E>(r: &Result<T, E>): Bool := match r {
    Result#Ok(_) => true,
    Result#Err(_) => false,
}

def is_err<T, E>(r: &Result<T, E>): Bool := match r {
    Result#Err(_) => true,
    Result#Ok(_) => false,
}

// Map the success value, leaving an error untouched.
def map_ok<T, U, E>(r: Result<T, E>, f: T -> U): Result<U, E> := match r {
    Result#Ok(v) => Result#Ok(f(v)),
    Result#Err(e) => Result#Err(e),
}

// Map the error value, leaving a success untouched.
def map_err<T, E, F>(r: Result<T, E>, f: E -> F): Result<T, F> := match r {
    Result#Ok(v) => Result#Ok(v),
    Result#Err(e) => Result#Err(f(e)),
}

// Chain a fallible step onto a success (the `bind` of the success channel).
def and_then<T, U, E>(r: Result<T, E>, f: T -> Result<U, E>): Result<U, E> := match r {
    Result#Ok(v) => f(v),
    Result#Err(e) => Result#Err(e),
}

// Forget the error, projecting into `Option`. Compose with `get_or` to recover a
// value-or-fallback: `get_or(ok(r), fallback)`.
def ok<T, E>(r: Result<T, E>): Option<T> := match r {
    Result#Ok(v) => Option#Some(v),
    Result#Err(_) => Option#None,
}



// ============== Heaping methods ===============


// Heaped: the `Unique` (Box-like) allocation strategy
//
// The compiler-internal strategy backing `deriving Heaped`. A `Unique<T>` is a
// non-`Copy` handle owning one heap node of type `T`; the compiler lowers a
// heaped type's construct / match / drop to `unique_alloc` / `unique_borrow`
// / `unique_release`. The allocation policy lives *here*, over the
// `Ptr` primitives, swapping the allocator is swapping these functions.

extern def malloc(size: Int): Ptr<Unit>;
extern def free(p: Ptr<Unit>): Unit;

type Unique<T> = U(Ptr<T>)

// Move a value onto the heap, returning the owning handle.
def unique_alloc<T>(value: T): Unique<T> := {
    let p: Ptr<T> = __ptr_cast(malloc(size_of::<T>()));
    __ptr_write(p, value);
    Unique#U(p)
}

// Drop a handle: structurally drop the node (recursing through nested `Unique`
// fields via the compiler's structural `__drop_in_place`), then free the
// backing allocation. This is the *deep* release used when an owned heaped
// value goes out of scope without being consumed.
def unique_release<T>(handle: Unique<T>): Unit := match handle {
    Unique#U(p) => {
        __drop_in_place(__ptr_read(p));
        free(__ptr_cast(p))
    }
}

// Move the node out of a handle and free *only* the backing cell (a shallow
// release): the node value is returned by move, so its fields become the
// caller's responsibility. This backs a consuming `match` on a heaped value:
// the node is read onto the stack and destructured, its bound fields moving to
// the arm bindings while the husk allocation is reclaimed here.
def unique_take<T>(handle: Unique<T>): T := match handle {
    Unique#U(p) => {
        let value: T = __ptr_read(p);
        free(__ptr_cast(p));
        value
    }
}
